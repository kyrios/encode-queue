[
 {
  "name": "2160 top, AAC copied",
  "args": [
   "ffmpeg",
   "-hide_banner",
   "-nostdin",
   "-y",
   "-loglevel",
   "error",
   "-nostats",
   "-progress",
   "pipe:1",
   "-i",
   "SRC",
   "-map",
   "0:v:0",
   "-map",
   "0:a:0",
   "-fps_mode",
   "passthrough",
   "-c:v",
   "libx265",
   "-preset",
   "slower",
   "-crf",
   "29",
   "-pix_fmt",
   "yuv420p10le",
   "-profile:v",
   "main10",
   "-tag:v",
   "hvc1",
   "-x265-params",
   "log-level=error:vbv-maxrate=5000:vbv-bufsize=10000",
   "-c:a",
   "copy",
   "-map_metadata",
   "-1",
   "-map_chapters",
   "-1",
   "-movflags",
   "+faststart",
   "OUT"
  ],
  "params": {
   "rung": "2160",
   "codec": "libx265",
   "preset": "slower",
   "crf": 29,
   "width": 3840,
   "height": 2160,
   "vbv_maxrate_kbps": 5000,
   "vbv_bufsize_kbit": 10000,
   "audio": {
    "mode": "copy"
   }
  },
  "source": {
   "width": 3840,
   "height": 2160
  }
 },
 {
  "name": "1080 scaled, mono AAC",
