   "yuv420p10le",
   "-profile:v",
   "main10",
   "-tag:v",
   "hvc1",
   "-x265-params",
   "log-level=error",
   "-af",
   "pan=mono|c0=0.5*c0+0.5*c1",
   "-c:a",
   "aac",
   "-b:a",
   "64k",
   "-map_metadata",
   "-1",
   "-map_chapters",
   "-1",
   "-movflags",
   "+faststart",
   "OUT"
  ],
  "params": {
   "rung": "1080",
   "codec": "libx265",
   "preset": "slower",
   "crf": 27,
   "width": 1920,
   "height": 1080,
   "audio": {
    "mode": "aac",
    "bitrate_kbps": 64,
    "mono": true
   }
  },
  "source": {
   "width": 3840,
   "height": 2160
  }
