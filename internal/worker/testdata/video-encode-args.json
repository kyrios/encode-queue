 {
  "name": "mastodon version with captions",
  "args": [
   "ffmpeg",
   "-hide_banner",
   "-nostdin",
   "-y",
   "-loglevel",
   "error",
   "-nostats",
   "-progress",
   "pipe:1",
   "-i",
   "SRC",
   "-map",
   "0:v:0",
   "-map",
   "0:a:0",
   "-fps_mode",
   "passthrough",
   "-vf",
   "crop=1214:2160:1313:0,scale=1080:1920:flags=lanczos,format=yuv420p,ass=filename=/work/input-captions",
   "-c:v",
   "libx264",
   "-preset",
   "slow",
   "-crf",
   "23",
   "-maxrate",
   "6000k",
   "-bufsize",
   "12000k",
   "-profile:v",
   "high",
   "-pix_fmt",
   "yuv420p",
   "-c:a",
   "copy",
   "-map_metadata",
   "-1",
   "-map_chapters",
   "-1",
   "-movflags",
   "+faststart",
   "OUT"
  ],
  "params": {
   "rung": "mastodon",
   "codec": "libx264",
   "preset": "slow",
   "crf": 23,
   "width": 1080,
   "height": 1920,
   "crop": {
    "width": 1214,
    "height": 2160,
    "x": 1313,
    "y": 0
   },
   "vbv_maxrate_kbps": 6000,
   "vbv_bufsize_kbit": 12000,
   "audio": {
    "mode": "copy"
   },
   "captions": {
    "input": "captions",
    "font": "Inter ExtraBold"
   }
  },
  "source": {
   "width": 3840,
   "height": 2160
  }
 },
