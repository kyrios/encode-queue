 {
  "kind": "compare",
  "name": "compare 4K source, 1080 rung",
  "every": 5,
  "source": [
   3840,
   2160
  ],
  "size": [
   1920,
   1080
  ],
  "args": [
   "ffmpeg",
   "-hide_banner",
   "-nostdin",
   "-loglevel",
   "info",
   "-nostats",
   "-threads",
   "2",
   "-i",
   "OUT",
   "-threads",
   "2",
   "-i",
   "SRC",
   "-filter_complex_threads",
   "2",
   "-filter_complex",
   "[0:v]select='not(mod(n\\,5))',setpts=N/TB,fps=1,format=yuv420p10le[d];[1:v]select='not(mod(n\\,5))',setpts=N/TB,fps=1,scale=1920:1080:flags=lanczos,format=yuv420p10le,split=3[r1][r2][r3];[d][r1]ssim=shortest=1[x];[x][r2]psnr=shortest=1[y];[y]format=yuv420p[y8];[r3]format=yuv420p[r8];[y8][r8]xpsnr=shortest=1[z]",
   "-map",
   "[z]",
   "-f",
   "null",
   "-"
  ]
 },
